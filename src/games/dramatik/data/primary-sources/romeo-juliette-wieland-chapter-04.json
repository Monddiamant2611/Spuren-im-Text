[
  {"id":"c04_tomb_romeo_order","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-1","text":"Gieb mir das Licht; so lieb dir dein Leben ist, befehl' ichs dir, du magst hören oder sehen, was du willst, so bleib von ferne stehen, und unterbrich mich nicht in meinem Vorhaben.","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_balthasar_doubt","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-4","text":"Ich fürchte seine Blike, und zweifle, daß er was Gutes im Sinn habe.","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_paris_view","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-6","text":"und nun ist er gekommen, irgend eine niederträchtige Schmach an ihren Leichnamen auszuüben: Ich will ihn anhalten","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_paris_arrest","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-6","text":"ich bemächtige mich deiner; gehorche, geh mit mir, du must sterben.","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_romeo_leave","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-7","text":"Guter junger Mensch, reize nicht einen verzweifelnden Mann; flieh von hinnen, und laß mich:","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_romeo_warning","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-7","text":"treibe mich nicht zur Wuth. O geh!","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_paris_reject","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-8","text":"Ich verschmähe dein Mitleiden, und arrestiere dich hier als einen Hochverräther.","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_tomb_fight","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":5,"scene":4,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0030.xhtml#paragraph-10","text":"(Sie fechten. Paris fällt.)","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_juliet_alone","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":4,"scene":3,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0024.xhtml#paragraph-8","text":"Ich muß meine schrekenvolle Scene nothwendig allein spielen – – Komm, Phiole – –","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_juliet_no_marriage","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":4,"scene":3,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0024.xhtml#paragraph-8","text":"Soll ich mich dann mit Gewalt an den Grafen verheurathen lassen? Nein, nein, diß soll es verwehren","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_juliet_poison_fear","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":4,"scene":3,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0024.xhtml#paragraph-8","text":"Wie, wenn es ein Gift wäre, das mir der Pater auf eine feine Art beybringen will, um mich aus dem Wege zu schaffen","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_juliet_tomb_fear","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":4,"scene":3,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0024.xhtml#paragraph-8","text":"Wie, wenn ich, nachdem man mich in die Gruft geleget, eher erwache als Romeo gekommen ist, mich abzuholen?","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_juliet_drinks","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":4,"scene":3,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0024.xhtml#paragraph-8","text":"Romeo, ich komme! Diß trink ich dir zu.","text_origin":"primary_source","editable":false,"source_verified":true},
  {"id":"c04_juliet_execution","work":"Romeo und Juliette","author":"William Shakespeare","translation":"Christoph Martin Wieland","act":4,"scene":3,"source":"docs/sources/william-shakespeare-romeo-und-juliette.epub","source_location":"OEBPS/chapter-0024.xhtml#paragraph-9","text":"(Sie trinkt die Phiole aus, und wirft sich auf ihr Bette.)","text_origin":"primary_source","editable":false,"source_verified":true}
]
